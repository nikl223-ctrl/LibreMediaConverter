; Engine configuration file.
config_version=5

[application]
config/name="Rettungsdienst Simulator Android"
run/main_scene="res://main.tscn"
config/features=PackedStringArray("4.5", "GL Compatibility")
config/description="Independently programmed rescue-driving simulator for Android"

[display]
window/size/viewport_width=1600
window/size/viewport_height=900
window/handheld/orientation=0
window/stretch/mode="canvas_items"

[physics]
3d/default_gravity=17.0

[rendering]
renderer/rendering_method="gl_compatibility"
renderer/rendering_method.mobile="gl_compatibility"
textures/vram_compression/import_etc2_astc=true
environment/defaults/default_clear_color=Color(0.46, 0.64, 0.82, 1)
anti_aliasing/quality/msaa_3d=2
