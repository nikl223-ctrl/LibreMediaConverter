# Place the game behind automatic HTTPS when used from the internet.
# SITE_DOMAIN must point to this Linux server; opens ports 80 and 443.
{$SITE_DOMAIN} {
  encode gzip zstd
  basic_auth {
    gamer {$BASIC_AUTH_HASH}
  }
  reverse_proxy browsergame:8765
  header {
    X-Content-Type-Options nosniff
    Referrer-Policy no-referrer
  }
}
