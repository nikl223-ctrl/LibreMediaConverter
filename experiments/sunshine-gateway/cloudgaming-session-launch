#!/usr/bin/env bash
# Runs ONLY on an authorized remote compute host. Moonlight applications
# are defined in Sunshine apps.json and started when clicked in Moonlight.
set -euo pipefail
umask 077
if ! command -v sunshine >/dev/null 2>&1; then
  echo 'Sunshine must already be installed on the remote compute host' >&2
  exit 3
fi
# IMPORTANT: Do not launch a cloud-gaming browser at startup:
# Sunshine must show both selectable apps first.
exec sunshine
