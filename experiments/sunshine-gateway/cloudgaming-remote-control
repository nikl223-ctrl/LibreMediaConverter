#!/usr/bin/env bash
# Run on the authorized remote compute host, as the desktop account.
set -euo pipefail
export XDG_RUNTIME_DIR="${XDG_RUNTIME_DIR:-/run/user/$(id -u)}"
export DBUS_SESSION_BUS_ADDRESS="${DBUS_SESSION_BUS_ADDRESS:-unix:path=$XDG_RUNTIME_DIR/bus}"
unit="cloudgaming-session.service"
if [[ ! -S "$XDG_RUNTIME_DIR/bus" ]]; then
  echo "The user-systemd bus is unavailable; configure the desktop session/linger first" >&2
  exit 3
fi
case "${1:-}" in
  start)
    # RuntimeMaxSec expiration leaves a failed unit; clear it before a NEW session.
    systemctl --user reset-failed "$unit" || true
    systemctl --user start "$unit"
    systemctl --user show "$unit" --property=ActiveState,SubState --no-pager
    ;;
  stop)
    systemctl --user stop "$unit"
    systemctl --user show "$unit" --property=ActiveState,SubState --no-pager
    ;;
  status)
    systemctl --user show "$unit" --property=ActiveState,SubState,ActiveEnterTimestamp,Result --no-pager
    ;;
  logs)
    journalctl --user -u "$unit" --since "30 minutes ago" --no-pager -n 60
    ;;
  *)
    echo "Usage: cloudgaming-remote-control {start|stop|status|logs}" >&2
    exit 2
    ;;
esac
