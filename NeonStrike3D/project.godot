; Engine configuration file.
; NEON STRIKE 3D - mobile-first first-person survival shooter.

config_version=5

[application]
config/name="RIVERLANDS STRIKE 3D"
config/icon="res://icon.svg"
run/main_scene="res://main.tscn"
config/features=PackedStringArray("4.5", "GL Compatibility")
config/description="An outdoor 3D river-valley FPS with 4K-generated materials, built for ARM64 Android."

[display]
window/size/viewport_width=1600
window/size/viewport_height=900
window/size/window_width_override=1600
window/size/window_height_override=900
window/stretch/mode="canvas_items"
window/handheld/orientation=0

[physics]
3d/default_gravity=26.0

[rendering]
textures/vram_compression/import_etc2_astc=true
renderer/rendering_method="gl_compatibility"
renderer/rendering_method.mobile="gl_compatibility"
textures/default_filters/use_nearest_mipmap_filter=false
environment/defaults/default_clear_color=Color(0.56, 0.73, 0.88, 1)
anti_aliasing/quality/msaa_3d=2
textures/canvas_textures/default_texture_filter=1
